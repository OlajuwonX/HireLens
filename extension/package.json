{
  "name": "hirelens-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "helper:install": "node build.mjs && node helper-dist/install.mjs",
    "helper:uninstall": "node helper-dist/install.mjs --uninstall"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "^20",
    "esbuild": "0.25.12",
    "playwright-core": "^1.65.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}

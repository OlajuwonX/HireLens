{
  "manifest_version": 3,
  "name": "HireLens",
  "version": "1.1.0",
  "key": "",
  "description": "Fill job applications with your HireLens profile, saved answers and best resume.",
  "action": { "default_popup": "popup.html", "default_title": "HireLens" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://apply.workable.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.bamboohr.com/*",
    "https://*.recruitee.com/*",
    "https://*.teamtailor.com/*",
    "https://*.breezy.hr/*",
    "https://*.jobvite.com/*",
    "https://*.icims.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://apply.workable.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.bamboohr.com/*",
        "https://*.recruitee.com/*",
        "https://*.teamtailor.com/*",
        "https://*.breezy.hr/*",
        "https://*.jobvite.com/*",
        "https://*.icims.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
